# Copy this file to .env.local and fill it in. Add the same values in Vercel
# (Project Settings > Environment Variables) when you deploy.

# Supabase > Project Settings > API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon key, or the newer publishable key (sb_publishable_...). Never the service role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# n8n: the Production URLs of the two Webhook nodes (see n8n/SETUP.md)
N8N_CHAT_WEBHOOK_URL=https://your-n8n.onrender.com/webhook/lamig-chat
N8N_NOTIFY_WEBHOOK_URL=https://your-n8n.onrender.com/webhook/lamig-notify

# A long random string. Put the same value in the n8n "Lamig webhook secret"
# Header Auth credential. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_WEBHOOK_SECRET=change-me
