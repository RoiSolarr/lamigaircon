# setup.sh creates .env from this file and fills in both values for you.

# Public address of n8n. Default: <your-ip-with-dashes>.sslip.io (free, no signup).
N8N_DOMAIN=

# Encrypts the credentials n8n stores. Generated once. Never change or lose it.
N8N_ENCRYPTION_KEY=

# n8n version (Docker tag). Change on purpose to upgrade, then run: docker compose up -d
N8N_VERSION=2.45.4
